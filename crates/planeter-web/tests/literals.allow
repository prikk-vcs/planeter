exact :: ui.rs :: bad :: a CSS class (badge colour)
exact :: ui.rs :: neutral :: a CSS class (the plain badge: no colour)
exact :: ui.rs :: evaluated :: a verify stage status token matched against; the word shown is the catalog's
exact :: ui.rs :: failed :: a verify stage status token matched against; the word shown is the catalog's
exact :: ui.rs :: not_evaluated :: a verify stage status token matched against; the word shown is the catalog's
exact :: ui.rs :: halted :: a verify stage status token matched against; the word shown is the catalog's
exact :: ui.rs :: README.md :: a file name compared with, to find the README
exact :: ui.rs :: text :: prikk's encoding token compared with
exact :: ui.rs :: ref :: a query-parameter name (serde rename)
exact :: ui.rs :: path :: a placeholder name (the path in the not-found title pattern)
exact :: ui.rs :: check :: a placeholder name (the blocking check in "not run (blocked by {check})")

