# --- templates: `|safe` is for sanitised repository content only
safe :: file.html :: html :: the Markdown renderer's output, sanitised by ammonia (RFC 003 T4); not catalog output
safe :: proposal.html :: html :: the proposal's description, rendered as Markdown and sanitised by ammonia (RFC 005 part 5); not catalog output
safe :: repo.html :: html :: the README, rendered and sanitised the same way

# --- the route registry's public reasons (IS-14): written for the reviewer of the route table, shown to no one
re :: * :: ^(GET|POST)$ :: an HTTP method in a route's declared method list
exact :: api.rs :: the API's own description: it names no repository and serves no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: the home page: a form to type an address; it lists nothing :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: parses an address and redirects to its page, the same for every repository; the page authorizes :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: the one stylesheet, embedded in the binary :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: sign-in: it authenticates the caller (throttled, CSRF-protected) and serves no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: begins single sign-on: a redirect to the provider; no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: completes single sign-on: it authenticates the caller; no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: ends the caller's own session (CSRF-protected); no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: sets the visitor's own language cookie, then returns to the page they were on (CSRF-protected); it names no repository and serves no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: lang_switch.rs :: {path}?{q} :: a format string of identifiers: a local path and its query, for the switcher's return address

# --- transport.rs (RFC 004 part 2): developer-facing keys and a query-parameter name; no response text
exact :: transport.rs :: ref :: a query-parameter name (serde rename)
exact :: transport.rs :: ip:unknown :: a rate-limit key when the client address is unknown (never shown)
exact :: transport.rs :: user:{} :: a rate-limit key built from an account id (never shown)
exact :: transport.rs :: rate_limited :: the refusal reason counted in the metrics (never shown to a person)
exact :: transport.rs :: unknown_kind :: the refusal reason counted in the metrics (never shown to a person)
exact :: transport.rs :: range_not_satisfiable :: the refusal reason counted in the metrics (never shown to a person)
exact :: transport.rs :: busy :: the refusal reason counted in the metrics (never shown to a person)
exact :: transport.rs :: unavailable :: the refusal reason counted in the metrics (never shown to a person)
exact :: transport.rs :: published :: the advertisement's `state` value (a stable JSON token, never shown as text)
exact :: transport.rs :: received :: the advertisement's `state`/`kind` value (a stable JSON token, never shown as text)
exact :: transport.rs :: branch :: the advertisement's `kind` value (a stable JSON token, never shown as text)
exact :: transport.rs :: tag :: the advertisement's `kind` value (a stable JSON token, never shown as text)
exact :: transport.rs :: bytes= :: the HTTP Range unit
exact :: transport.rs :: the read task ended :: an internal error value for a failed read task; never shown
exact :: transport.rs :: {}-{}.archive :: a download file name built from the owner and repository names
exact :: transport.rs :: {}-{}-{}.bundle :: a download file name built from the owner, repository and ref names
exact :: transport.rs :: bytes */{size} :: the Content-Range of an unsatisfiable range
exact :: transport.rs :: application/octet-stream :: a media type
exact :: transport.rs :: attachment; filename="{filename}" :: the Content-Disposition of a download
exact :: transport.rs :: bytes :: the Accept-Ranges unit
exact :: transport.rs :: bytes {first}-{}/{size} :: the Content-Range of a partial response

