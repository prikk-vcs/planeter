# The allowlist of tests/catalog_checks.rs (RFC 012 D-5): every user-visible-looking literal that is NOT a
# catalog message, with the reason. Reviewed like code: a line added here is a decision.
#
# kind :: file :: literal or pattern :: reason
#   exact  the literal, as written in the source (or the template text)
#   re     a regular expression the literal must match completely
#   safe   a template expression that may be printed with `|safe`
#   scope  a source file that is not scanned, with the reason

scope :: openapi.rs :: * :: the OpenAPI document is developer-facing prose and stays English (RFC 012 D-3d); it says so in its description
scope :: security.rs :: * :: header values and policy names, not text a person reads
scope :: sanitize.rs :: * :: sanitiser configuration (HTML tag and attribute names)
scope :: cookies.rs :: * :: cookie names and attributes
scope :: principal.rs :: * :: header and token handling
scope :: client_ip.rs :: * :: network parsing and its operator-facing log lines
scope :: gate.rs :: * :: operator-facing log lines and the gate's counters
scope :: budget.rs :: * :: operator-facing configuration messages (start-up)
scope :: routes.rs :: * :: the route registry (IS-14): developer-facing panic messages of the build-time table; no response carries them

# --- routes, URLs and templates
re :: * :: ^/.* :: a route or URL path
re :: * :: ^\?ref=.* :: a query string built by the code
re :: * :: ^&ref=.* :: a query string built by the code
re :: * :: ^\{.*\}/\{.*\}$ :: a format string of identifiers and separators, no words
re :: * :: ^\{[a-z_]*\}\{?[a-z_]*\}?/?$ :: a format string of identifiers
re :: * :: ^\.\./static/app\.css$ :: the stylesheet embedded with include_str!
re :: * :: ^[a-z_]+\.html$ :: a template file name
exact :: ui.rs :: {prefix}{d} :: a format string of identifiers

# --- tokens matched or classes emitted, never shown as words
exact :: ui.rs :: warn :: a CSS class (badge colour)
exact :: ui.rs :: bad :: a CSS class (badge colour)
exact :: ui.rs :: neutral :: a CSS class (the plain badge: no colour)
exact :: ui.rs :: evaluated :: a verify stage status token matched against; the word shown is the catalog's
exact :: ui.rs :: failed :: a verify stage status token matched against; the word shown is the catalog's
exact :: ui.rs :: not_evaluated :: a verify stage status token matched against; the word shown is the catalog's
exact :: ui.rs :: halted :: a verify stage status token matched against; the word shown is the catalog's
exact :: ui.rs :: README.md :: a file name compared with, to find the README
exact :: ui.rs :: text :: prikk's encoding token compared with
exact :: ui.rs :: ref :: a query-parameter name (serde rename)
exact :: ui.rs :: path :: a placeholder name (the path in the not-found title pattern)
exact :: ui.rs :: check :: a placeholder name (the blocking check in "not run (blocked by {check})")

# --- headers, media types, protocol words
exact :: ui.rs :: text/html; charset=utf-8 :: a media type
exact :: ui.rs :: text/css; charset=utf-8 :: a media type
exact :: ui.rs :: public, max-age=3600 :: a Cache-Control value
exact :: api.rs :: application/json :: a media type
exact :: api.rs :: GET :: an Allow header value
exact :: api.rs :: ref :: a query-parameter name (serde rename)
exact :: api.rs :: the read task did not complete :: an internal error value that maps to the `internal` code; never shown
exact :: headers.rs :: no-store :: a Cache-Control value
exact :: headers.rs :: private, no-cache :: a Cache-Control value
exact :: headers.rs :: Cookie :: a Vary token
exact :: headers.rs :: Authorization :: a Vary token
exact :: headers.rs :: Accept-Language :: a Vary token
exact :: headers.rs :: permissions-policy :: a header name
exact :: headers.rs :: camera=(), microphone=(), geolocation=(), payment=(), usb=() :: a Permissions-Policy value
exact :: headers.rs :: max-age=15552000 :: an HSTS value
exact :: authn.rs :: Bearer  :: the Authorization scheme prefix

# --- errors.rs: the stable machine codes and the OpenAPI prose (developer-facing, English by decision)
re :: errors.rs :: ^(not_found|unavailable|busy|invalid_request|method_not_allowed|raw_elsewhere|too_large|internal|transport_off|unknown_ref|unknown_kind|bundle_of_received_ref|not_verified|export_failed|rate_limited|range_not_satisfiable)$ :: a stable machine-readable error code
exact :: errors.rs :: document :: a placeholder name
re :: errors.rs :: ^(forbidden|length_required|payload_too_large|needs_recovery|quota_exceeded|base_unknown|declaration_misses_added|declared_not_held|no_new_content|unknown_change|change_not_open|not_your_change|accept_refused|intent_pending|incomplete)$ :: a stable machine-readable error code (RFC 004 part 3b)
re :: errors.rs :: ^(the caller can read the repository but|a proposal must declare|the proposal is larger than|the repository is waiting for recovery|a limit on proposals was reached|the declared base is not|the declared patches leave|the declared patches name|the artifact added nothing|the repository has no change|the change is landed|the change was opened by somebody|prikk refused the artifact and|somebody else has begun|the accept did not finish).* :: ErrorCode::description: OpenAPI prose for developers, English by decision (D-3d)
re :: transport.rs :: ^(reason|state|limit|used|quota|unit|count|patch_ids|detail|intent|cause|mebibytes)$ :: a JSON field name or value of the propose response (machine-readable)
re :: transport.rs :: ^(bad_framing|forbidden|content_type|length_required|payload_too_large|too_short|magic|no_artifact|truncated|unknown_field|not_json|bad_metadata|length|propose|over_budget)$ :: a stable machine-readable reason code or a metrics key
exact :: transport.rs :: unknown field :: the text of serde's error, matched to tell an unknown field from invalid JSON
exact :: transport.rs :: PLANETER-PROPOSE-1n :: the magic bytes that start a proposal's body (a protocol token, not text)
exact :: transport.rs :: application/json :: a media type
exact :: transport.rs :: no-store :: a Cache-Control value
exact :: quota.rs :: limit :: a placeholder name
exact :: quota.rs :: used :: a placeholder name
exact :: errors.rs :: code :: a JSON field name
exact :: errors.rs :: message :: a JSON field name
exact :: errors.rs :: hint :: a JSON field name
re :: errors.rs :: ^(no such resource, or|the repository could not be read|too many requests|a malformed parameter|the method is not supported|the raw route, asked|the response would exceed|an internal fault|artifact fetches are not set up|the repository has no ref|the fetch kind is neither|a bundle of a received ref|the exported artifact did not verify|the export failed, hit|too many requests from this|a byte range the current).* :: ErrorCode::description: OpenAPI prose for developers, English by decision (D-3d)

# --- templates: `|safe` is for sanitised repository content only
safe :: file.html :: html :: the Markdown renderer's output, sanitised by ammonia (RFC 003 T4); not catalog output
safe :: repo.html :: html :: the README, rendered and sanitised the same way

# --- the route registry's public reasons (IS-14): written for the reviewer of the route table, shown to no one
re :: * :: ^(GET|POST)$ :: an HTTP method in a route's declared method list
exact :: api.rs :: the API's own description: it names no repository and serves no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: the home page: a form to type an address; it lists nothing :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: parses an address and redirects to its page, the same for every repository; the page authorizes :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: the one stylesheet, embedded in the binary :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: sign-in: it authenticates the caller (throttled, CSRF-protected) and serves no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: begins single sign-on: a redirect to the provider; no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: completes single sign-on: it authenticates the caller; no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: ends the caller's own session (CSRF-protected); no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: ui.rs :: sets the visitor's own language cookie, then returns to the page they were on (CSRF-protected); it names no repository and serves no repository data :: the reason a public route is public (route table, IS-14); never shown
exact :: lang_switch.rs :: {path}?{q} :: a format string of identifiers: a local path and its query, for the switcher's return address

# --- transport.rs (RFC 004 part 2): developer-facing keys and a query-parameter name; no response text
exact :: transport.rs :: ref :: a query-parameter name (serde rename)
exact :: transport.rs :: ip:unknown :: a rate-limit key when the client address is unknown (never shown)
exact :: transport.rs :: user:{} :: a rate-limit key built from an account id (never shown)
exact :: transport.rs :: rate_limited :: the refusal reason counted in the metrics (never shown to a person)
exact :: transport.rs :: unknown_kind :: the refusal reason counted in the metrics (never shown to a person)
exact :: transport.rs :: range_not_satisfiable :: the refusal reason counted in the metrics (never shown to a person)
exact :: transport.rs :: busy :: the refusal reason counted in the metrics (never shown to a person)
exact :: transport.rs :: unavailable :: the refusal reason counted in the metrics (never shown to a person)
exact :: transport.rs :: published :: the advertisement's `state` value (a stable JSON token, never shown as text)
exact :: transport.rs :: received :: the advertisement's `state`/`kind` value (a stable JSON token, never shown as text)
exact :: transport.rs :: branch :: the advertisement's `kind` value (a stable JSON token, never shown as text)
exact :: transport.rs :: tag :: the advertisement's `kind` value (a stable JSON token, never shown as text)
exact :: transport.rs :: bytes= :: the HTTP Range unit
exact :: transport.rs :: the read task ended :: an internal error value for a failed read task; never shown
exact :: transport.rs :: {}-{}.archive :: a download file name built from the owner and repository names
exact :: transport.rs :: {}-{}-{}.bundle :: a download file name built from the owner, repository and ref names
exact :: transport.rs :: bytes */{size} :: the Content-Range of an unsatisfiable range
exact :: transport.rs :: application/octet-stream :: a media type
exact :: transport.rs :: attachment; filename="{filename}" :: the Content-Disposition of a download
exact :: transport.rs :: bytes :: the Accept-Ranges unit
exact :: transport.rs :: bytes {first}-{}/{size} :: the Content-Range of a partial response
