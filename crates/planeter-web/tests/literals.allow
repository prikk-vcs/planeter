exact :: headers.rs :: private, no-cache :: a Cache-Control value
exact :: headers.rs :: Cookie :: a Vary token
exact :: headers.rs :: Authorization :: a Vary token
exact :: headers.rs :: Accept-Language :: a Vary token
exact :: headers.rs :: permissions-policy :: a header name
