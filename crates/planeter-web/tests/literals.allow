# The allowlist of tests/catalog_checks.rs (RFC 012 D-5): every user-visible-looking literal that is NOT a
# catalog message, with the reason. Reviewed like code: a line added here is a decision.
#
# kind :: file :: literal or pattern :: reason
#   exact  the literal, as written in the source (or the template text)
#   re     a regular expression the literal must match completely
#   safe   a template expression that may be printed with `|safe`
#   scope  a source file that is not scanned, with the reason

scope :: openapi.rs :: * :: the OpenAPI document is developer-facing prose and stays English (RFC 012 D-3d); it says so in its description
scope :: security.rs :: * :: header values and policy names, not text a person reads
scope :: sanitize.rs :: * :: sanitiser configuration (HTML tag and attribute names)
scope :: cookies.rs :: * :: cookie names and attributes
scope :: principal.rs :: * :: header and token handling
scope :: client_ip.rs :: * :: network parsing and its operator-facing log lines
scope :: gate.rs :: * :: operator-facing log lines and the gate's counters
scope :: budget.rs :: * :: operator-facing configuration messages (start-up)
scope :: routes.rs :: * :: the route registry (IS-14): developer-facing panic messages of the build-time table; no response carries them

# --- routes, URLs and templates
re :: * :: ^/.* :: a route or URL path
re :: * :: ^\?ref=.* :: a query string built by the code
re :: * :: ^&ref=.* :: a query string built by the code
re :: * :: ^\{.*\}/\{.*\}$ :: a format string of identifiers and separators, no words
re :: * :: ^\{[a-z_]*\}\{?[a-z_]*\}?/?$ :: a format string of identifiers
re :: * :: ^\.\./static/app\.css$ :: the stylesheet embedded with include_str!
re :: * :: ^[a-z_]+\.html$ :: a template file name
exact :: ui.rs :: {prefix}{d} :: a format string of identifiers

# --- tokens matched or classes emitted, never shown as words
